# Pełny publiczny adres produkcyjny, np. https://example.com
NEXT_PUBLIC_SITE_URL=

# Ustaw true wyłącznie na środowisku produkcyjnym gotowym do indeksowania.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Klucz API ElevenLabs. Tylko serwer — bez prefiksu NEXT_PUBLIC_.
ELEVENLABS_API_KEY=

# ID agenta z ElevenAgents, zwykle zaczyna się od agent_.
ELEVENLABS_AGENT_ID=

# ID numeru, z którego agent dzwoni (phone_number_id).
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Opcjonalnie. Domyślnie https://api.elevenlabs.io
# Rezydencja EU: https://api.eu.residency.elevenlabs.io
ELEVENLABS_API_BASE_URL=

# Opcjonalnie: twilio, sip albo exotel.
# Gdy puste, rodzaj numeru jest odczytywany z konta ElevenLabs.
ELEVENLABS_TELEPHONY_PROVIDER=

# Klucz API Resend. Tylko serwer — bez prefiksu NEXT_PUBLIC_.
# Formularz /kontakt wysyła lead na skrzynki zespołu.
RESEND_API_KEY=

# Token REST SuperVoIP (Bearer). Tylko serwer — bez prefiksu NEXT_PUBLIC_.
SUPERVOIP_API_TOKEN=

# ID numeru komórkowego, z którego wychodzi SMS. Sam numer telefonu tu nie zadziała.
# Można podać samo ID albo /api/voip_numbers/12345.
SUPERVOIP_VOIP_NUMBER_ID=

# Numery, które dostają powiadomienie SMS, po przecinku.
# Np. +48600100200,+48600100201
SUPERVOIP_SMS_TO=
